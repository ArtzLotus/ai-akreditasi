# Salin ke .env (jangan dikomit). Prefix AKREDITASI_MODEL_ dibaca akreditasi/llm/config.py
AKREDITASI_MODEL_BASE_URL=https://model.taveve.my.id/v1
AKREDITASI_MODEL_MODEL=gemma3:4b
AKREDITASI_MODEL_API_KEY=
AKREDITASI_MODEL_TEMPERATURE=0
AKREDITASI_MODEL_TIMEOUT_S=120
AKREDITASI_MODEL_PROMPT_VERSION=v3
# Pencarian vektor (mis. bge-m3:latest); kosong = BM25 saja
AKREDITASI_MODEL_EMBEDDING_MODEL=
AKREDITASI_MODEL_MAX_TOKENS_VISUAL=1536
# Endpoint ini masih publik tanpa autentikasi (NFR-17). Hanya untuk data fiktif:
AKREDITASI_MODEL_ALLOW_PUBLIC=0

# OCR halaman pindaian (akreditasi/ocr). Kosong = cari otomatis:
# PATH, lalu C:\Program Files\Tesseract-OCR\tesseract.exe
AKREDITASI_TESSERACT_CMD=
# Folder model bahasa (--tessdata-dir). Kosong = %LOCALAPPDATA%\tessdata bila memuat ind.traineddata,
# selain itu bawaan Tesseract.
AKREDITASI_TESSDATA_DIR=
# 0 mematikan OCR bawaan pipeline penilaian
AKREDITASI_OCR=1
